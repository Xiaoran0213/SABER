# SABER environment template. Copy to `.saber_env` (auto-loaded, gitignored)
# or export these in your shell. See docs/DATA.md for what each root contains.

# Required: processed data + precomputed ESM-2 caches
SABER_DATA_ROOT=/path/to/proteomics
SABER_PLM_ROOT=/path/to/precomputed_plm

# Optional: benchmark slice copy (default: $SABER_DATA_ROOT/saber_benchmark)
#SABER_BENCHMARK_ROOT=

# Optional: external baselines (Tier-2 only). The adapters ship with the
# repository under external_adapters/; set SABER_EXTERNAL_REPOS to the
# directory holding the upstream clones (see external_adapters/README.md).
#SABER_EXTERNAL_REPOS=/path/to/external_repos
#SABER_EXT_METHODS_ROOT=/path/to/adapters        # default: <repo>/external_adapters

# Optional: annotation source for re-materializing the benchmark slice
# from the original evaluation tree (legacy; the archived data package
# ships the materialized slice)
#SABER_PROTAE_ROOT=/path/to/ProtAE_4.0

# Optional: where training runs are written (default: ./outputs)
#SABER_OUTPUTS_ROOT=

# Optional: HuggingFace cache for rebuilding PLM features (default: HF_HOME)
#SABER_HF_CACHE=

# Optional: foldseek structure-token TSV, only for the SaProt prior ablation
#SABER_SAPROT_TOKENS=
